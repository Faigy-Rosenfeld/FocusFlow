# ── Focus-Flow · Environment Template ──────────────────────
# העתיקי קובץ זה ל-server/.env ומלאי את הערכים שלך.
# לעולם אל תעלי את server/.env ל-git.

# ── PostgreSQL ──────────────────────────────────────────────
DB_NAME=focus_flow_db
DB_USER=postgres
DB_PASSWORD=your_password_here

DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/focus_flow_db

# ── JWT ─────────────────────────────────────────────────────
# צרי מחרוזת אקראית ארוכה:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ── Gemini (אופציונלי) ──────────────────────────────────────
# השאירי ריק — האפליקציה עובדת גם בלי זה
GEMINI_API_KEY=
